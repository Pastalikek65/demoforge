{
  "name": "demoforge",
  "version": "1.0.0",
  "description": "Record a browser workflow once. Replay it and publish video demos and step-by-step guides locally.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Pastalikek65",
  "repository": "https://github.com/Pastalikek65/demoforge",
  "engines": {
    "node": "^24.0.0"
  },
  "main": "dist/electron/main.js",
  "bin": {
    "demoforge": "dist/cli.js"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:browser": "vitest run tests/browser --testTimeout=60000",
    "start": "electron .",
    "cli": "tsx src/cli.ts",
    "package": "npm run build && node scripts/distribution-notices.mjs && electron-builder",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "commander": "15.0.0",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
